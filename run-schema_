<?php
/**
 * ONE-OFF MIGRATION RUNNER — combines everything that's been added to
 * `users` since the base schema.sql: presence, username_changed_at, and
 * last_seen. Needed any time the DB is reset from schema.sql alone, since
 * none of these three ever made it into that file (see the note at the
 * bottom about fixing that for good).
 *
 * HOW TO USE:
 *   1. Upload this file to www/run-migration-social-columns.php
 *   2. Visit https://aghimuan.renyuzaki.me/run-migration-social-columns.php
 *      in your browser once.
 *   3. Delete the file from the server immediately after — it has no
 *      password/auth gate, so leaving it up would let anyone re-run it.
 */
declare(strict_types=1);
require_once __DIR__ . '/includes/db.php';

header('Content-Type: text/plain; charset=utf-8');

$pdo = get_db();

$columns = [
    'presence'            => "ALTER TABLE users ADD COLUMN presence TEXT DEFAULT 'online'",
    'username_changed_at' => "ALTER TABLE users ADD COLUMN username_changed_at TEXT",
    'last_seen'           => "ALTER TABLE users ADD COLUMN last_seen INTEGER",
];

foreach ($columns as $name => $sql) {
    try {
        $pdo->exec($sql);
        echo "Added column '$name'.\n";
    } catch (PDOException $e) {
        if (strpos($e->getMessage(), 'duplicate column') !== false) {
            echo "Column '$name' already exists — skipped.\n";
        } else {
            echo "FAILED on '$name': " . $e->getMessage() . "\n";
        }
    }
}

echo "\nDone. You can delete this file from the server now.\n";