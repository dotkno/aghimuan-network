<?php
/**
 * ONE-OFF DB RESET SCRIPT — wipes the broken aghimuan.db and rebuilds it
 * fresh from schema.sql.
 *
 * HOW TO USE:
 *   1. Upload this file to www/reset-db.php
 *   2. Visit https://aghimuan.renyuzaki.me/reset-db.php
 *      in your browser once.
 *   3. Delete the file from the server immediately after — it has no
 *      password/auth gate, so leaving it up would let anyone wipe your DB.
 */
declare(strict_types=1);
require_once __DIR__ . '/includes/db.php';

header('Content-Type: text/plain; charset=utf-8');

echo "Starting database reset...\n\n";

// Path must match exactly what is in includes/db.php
 $dbPath = __DIR__ . '/../data/aghimuan.db';

// 1. Delete the old database files so get_db() triggers the schema.sql import
 $filesToDelete = [
    $dbPath,
    $dbPath . '-wal',
    $dbPath . '-shm'
];

foreach ($filesToDelete as $file) {
    if (file_exists($file)) {
        if (unlink($file)) {
            echo "Deleted: " . basename($file) . "\n";
        } else {
            echo "FAILED to delete: " . basename($file) . " (check folder permissions)\n";
        }
    } else {
        echo "Skipped (not found): " . basename($file) . "\n";
    }
}

echo "\nRebuilding from schema.sql...\n";

// 2. Re-initialize. Because the DB file is gone, db.php will detect $isNew = true
// and automatically execute schema.sql.
try {
    $pdo = get_db();
    echo "\n[OK] Database successfully recreated at: " . $dbPath . "\n";
    echo "You can now visit /signup.php and it will work perfectly.\n";
} catch (Exception $e) {
    echo "\nFAILED to rebuild database: " . $e->getMessage() . "\n";
}

echo "\nDone. You can delete this file from the server now.\n";